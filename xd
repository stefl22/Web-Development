import tkinter as tk
import threading
import time
import itertools
import string
from multiprocessing import Pool, cpu_count

def _search_chunk(args):
    """
    Worker: try all combinations of a given length that start with prefix.
    """
    prefix, length, password, chars = args
    # If prefix already full length, just compare directly
    if len(prefix) == length:
        return prefix if prefix == password else None

    # Otherwise generate all suffixes
    for suffix in itertools.product(chars, repeat=length - 1):
        attempt = prefix + ''.join(suffix)
        if attempt == password:
            return attempt
    return None

def parallel_brute_force(password):
    """
    Parallel brute-force across lowercase, uppercase, digits, punctuation.
    Splits each length’s search space by first character.
    """
    start_time = time.time()
    chars = (
        string.ascii_lowercase +
        string.ascii_uppercase +
        string.digits +
        string.punctuation
    )
    n_procs = cpu_count()

    # Try increasing lengths until found
    for length in itertools.count(1):
        tasks = [(prefix, length, password, chars) for prefix in chars]
        with Pool(n_procs) as pool:
            for result in pool.imap_unordered(_search_chunk, tasks):
                if result is not None:
                    elapsed = time.time() - start_time
                    return result, elapsed

def crack_password():
    pwd = entry.get().strip()
    if not pwd:
        result_label.config(text="Please enter a password.")
        return

    crack_button.config(state=tk.DISABLED)
    loader_label.config(text="Cracking…")
    result_label.config(text="")

    def worker():
        found, elapsed = parallel_brute_force(pwd)
        root.after(0, lambda: finish(found, elapsed))

    threading.Thread(target=worker, daemon=True).start()

def finish(found, elapsed):
    loader_label.config(text="")
    result_label.config(
        text=f"Password: {found}\nTime Elapsed: {elapsed:.2f} seconds"
    )
    crack_button.config(state=tk.NORMAL)

# --- Tkinter UI setup ---
root = tk.Tk()
root.title("Parallel Brute‑Force Cracker")

tk.Label(root, text="Enter Password:").pack(padx=10, pady=5)
entry = tk.Entry(root)
entry.pack(padx=10, pady=5)

crack_button = tk.Button(root, text="Crack", command=crack_password)
crack_button.pack(padx=10, pady=5)

loader_label = tk.Label(root, text="")
loader_label.pack(padx=10, pady=5)

result_label = tk.Label(root, text="")
result_label.pack(padx=10, pady=5)

root.mainloop()
